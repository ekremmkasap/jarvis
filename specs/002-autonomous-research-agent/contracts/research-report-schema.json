{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ResearchItem",
  "description": "Kaynak'tan çekilen tek bir araştırma içerik birimi",
  "type": "object",
  "required": ["id", "source", "title", "url", "fetched_at"],
  "properties": {
    "id": {
      "type": "string",
      "description": "URL'nin sha256 hash'i (hex, 16 karakter prefix)"
    },
    "source": {
      "type": "string",
      "enum": ["github", "reddit", "twitter", "instagram"]
    },
    "title": {
      "type": "string",
      "maxLength": 300
    },
    "url": {
      "type": "string",
      "format": "uri"
    },
    "summary": {
      "type": "string",
      "maxLength": 500,
      "description": "AI özet veya ilk 280 karakter"
    },
    "fetched_at": {
      "type": "string",
      "format": "date-time"
    },
    "included_in_brief": {
      "type": ["string", "null"],
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "description": "Hangi günlük brief'e dahil edildi (YYYY-MM-DD)"
    }
  },
  "additionalProperties": false
}
